# Local-only demo. Production never permits this bypass.
AUTH_PREVIEW_MODE=false
APP_ORIGIN=http://127.0.0.1:5174

# Local development uses a SQLite file. Production requires hosted Turso and a token.
TURSO_DATABASE_URL=file:./mirana.local.db
TURSO_AUTH_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private usage dashboard. One exact Google-verified owner email; blank denies everyone.
# Server-only; never use NEXT_PUBLIC_ for this field.
ADMIN_OWNER_EMAIL=

# Independent random secrets, each at least 32 characters. Never expose to the browser.
AUTOMATION_SECRET=
CRON_SECRET=

# Explicit provider selection. Google credentials alone never switch providers.
# Ordinary API usage is billable; Google promotional-credit eligibility is separate.
RESEARCH_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.5
RESEARCH_MAX_JOBS=1
# Safe hashed stage/count/usage diagnostics; off disables logging. No payloads or hidden reasoning.
RESEARCH_LOG_LEVEL=info
# Legacy two-call helper only; the staged worker uses RESEARCH_STEP_TIMEOUT_MS.
RESEARCH_TIMEOUT_MS=90000
RESEARCH_STEP_TIMEOUT_MS=120000
RESEARCH_MAX_CALLS=8
RESEARCH_MAX_ROUNDS=2
RESEARCH_MAX_INPUT_TOKENS=100000
RESEARCH_MAX_OUTPUT_TOKENS=24000

# Opt-in Vertex research: set RESEARCH_PROVIDER=vertex explicitly.
# Also used by the separate local benchmark (see GEMINI_BENCHMARK.md).
# Keep these server-side. The staged engine uses explicit-project global generateContent.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GEMINI_RESEARCH_MODEL=gemini-3.8-flash

# Daily Vercel Hobby scheduling: 24. Set 1 only with an hourly dispatcher.
WORKER_MIN_INTERVAL_HOURS=24

RESEND_API_KEY=
EMAIL_FROM=

# Optional operator-controlled service that obtains actual merchant checkout quotes.
# AI/search snippets alone never qualify a deal email.
OFFER_VERIFIER_URL=
OFFER_VERIFIER_TOKEN=
OFFER_VERIFIER_SIGNING_SECRET=

MIRANA_DEMO_MODE=false

# Local-only tool-connected Gemini research; false keeps the existing path.
# See PRODUCT_TOOLS_SETUP.md. No provider calls are made by tools:status.
RESEARCH_TOOLS_ENABLED=false
RESEARCH_MAX_TOOL_CALLS=12
SERPAPI_API_KEY=
BRIGHT_DATA_API_TOKEN=
# Copy scraper dataset IDs from the Bright Data Amazon/Flipkart scraper library.
BRIGHT_DATA_AMAZON_DATASET_ID=
BRIGHT_DATA_FLIPKART_DATASET_ID=
# Optional paid Amazon India price-history service; not needed for search.
KEEPA_API_KEY=

# Local web tools: keyless uses limited free access and ignores any saved key.
# Use keyed explicitly to consume your account credits; disabled switches tools off.
FIRECRAWL_ACCESS_MODE=keyless
FIRECRAWL_API_KEY=
TAVILY_ACCESS_MODE=keyless
TAVILY_API_KEY=

# Explicit research release switch; server-only, off until approved.
RESEARCH_PRODUCTION_ENABLED=false
# Shared database limits for new research jobs over a rolling 24 hours.
RESEARCH_DAILY_JOB_LIMIT=10
RESEARCH_USER_DAILY_JOB_LIMIT=3
