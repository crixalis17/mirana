# Local-only demo. Production never permits this bypass.
AUTH_PREVIEW_MODE=false
APP_ORIGIN=http://127.0.0.1:5174

# Local development uses a SQLite file. Production requires hosted Turso and a token.
TURSO_DATABASE_URL=file:./mirana.local.db
TURSO_AUTH_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Independent random secrets, each at least 32 characters. Never expose to the browser.
AUTOMATION_SECRET=
CRON_SECRET=

# Separate API credentials; usage is billed by the provider.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.5
RESEARCH_MAX_JOBS=1
RESEARCH_TIMEOUT_MS=90000

# Daily Vercel Hobby scheduling: 24. Set 1 only with an hourly dispatcher.
WORKER_MIN_INTERVAL_HOURS=24

RESEND_API_KEY=
EMAIL_FROM=

# Optional operator-controlled service that obtains actual merchant checkout quotes.
# AI/search snippets alone never qualify a deal email.
OFFER_VERIFIER_URL=
OFFER_VERIFIER_TOKEN=
OFFER_VERIFIER_SIGNING_SECRET=

MIRANA_DEMO_MODE=false
